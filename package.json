{
  "name": "tenant-leak-check",
  "version": "0.1.0",
  "description": "Tests whether one tenant can read or change another tenant's data in a local Supabase project. An isolation test, not a security certification.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tenant-leak-check": "src/cli.ts"
  },
  "scripts": {
    "tlc": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "smol-toml": "^1.9.1"
  }
}
